{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qalamark",
  "version": "0.1.0",
  "identifier": "io.github.mmbesar.qalamark",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qalamark",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "useHttpsScheme": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "Light Markdown notes with table formulas and live sharing",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
