<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="10dp" android:background="@drawable/qm_widget_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr">
    <TextView android:id="@+id/w_prev" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="‹" android:textSize="24sp" android:textColor="#CBA6F7" />
    <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:textSize="17sp" android:textStyle="bold" android:textColor="#CDD6F4" android:singleLine="true" android:ellipsize="end"
      android:textDirection="firstStrong" android:textAlignment="textStart" android:paddingLeft="4dp" android:paddingRight="4dp" />
    <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#CBA6F7" android:paddingRight="4dp" />
    <TextView android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="#CBA6F7" />
  </LinearLayout>
  <ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" />
  <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:visibility="gone"
    android:text="@string/qm_widget_empty" android:textColor="#9399B2" android:textSize="14sp" />
</LinearLayout>
